# FixMate API Server — copy to .env and fill real values

PORT=5000
NODE_ENV=development

# MongoDB (same cluster as the client's MONGODB_URI)
MONGODB_URI=mongodb://127.0.0.1:27017/fixmate

# Browser origins allowed by CORS — production must list BOTH live domains:
#   https://YOUR-CLIENT.vercel.app, http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# MUST match JWT_SECRET in client/.env.local (token bridge secret)
JWT_SECRET=change-me-to-a-long-random-string

# BetterAuth shared secret — MUST match BETTER_AUTH_SECRET in client/.env.local
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Your deployed client (Stripe redirects + links)
CLIENT_URL=http://localhost:3000

# Stripe TEST MODE keys — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ImgBB key — https://api.imgbb.com/  (stored server-side only)
IMGBB_API_KEY=...
