# FixMate Server — copy to .env and fill real values
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed client origins (CORS)
CORS_ORIGINS=http://localhost:3000

# MongoDB connection string (same cluster as the client)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/fixmate?retryWrites=true&w=majority

# MUST match JWT_SECRET in client/.env.local (token bridge secret)
JWT_SECRET=change-me-to-a-long-random-string

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe webhook signing secret — https://dashboard.stripe.com/webhooks (test mode)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ImgBB API key — https://api.imgbb.com/
IMGBB_API_KEY=xxx
